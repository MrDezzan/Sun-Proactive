# Database (PostgreSQL with pgvector, see sun-proactive/docker-compose.yml)
DATABASE_URL=postgresql://postgres:password@localhost:5432/sunproactive

# JWT
JWT_SECRET=change-me

# AI (OpenAI-compatible API for embeddings, matching and chat)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
ALEM_AI_MODEL=your-model-name

# Gemini (photo-report verification)
GEMINI_API_KEY=your-gemini-key

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Cron (secret header for background AI jobs)
CRON_SECRET=change-me
